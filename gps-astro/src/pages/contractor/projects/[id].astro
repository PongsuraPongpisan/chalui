---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectReviews from '../../../components/ProjectReviews.astro';
import { localizeRoad, localizeWorkType, WORK_TYPE_LABELS } from '../../../lib/project-localization.js';
import { rowToClient } from '../../../lib/project-mapper.js';
import { getSession } from '../../../lib/session.js';
import { supabase } from '../../../lib/supabase.js';

export const prerender = false;

type Project = Record<string, unknown> & {
  id: number; name?: string; province?: string; contractor?: string; status?: string;
  workLevel?: string; roadName?: string; lat?: number; lng?: number;
  boundaryMeters?: number; start?: string; end?: string; workType?: string;
  statusNote?: string; completed_at?: string; sitePhotos?: unknown; checkpointPhotos?: Record<string, unknown>;
};

const STATUS_LABELS: Record<string, string> = {
  completed: 'เสร็จสิ้น', 'in-progress': 'กำลังทำ', delayed: 'ล่าช้า', planned: 'วางแผน',
};
const LEVEL_LABELS: Record<string, string> = {
  critical: 'ระดับ 1 — วิกฤต', high: 'ระดับ 2 — สูง',
  medium: 'ระดับ 3 — ปานกลาง', routine: 'ระดับ 4 — ทั่วไป',
};
const CHECKPOINT_META = [
  { key: 'cone', num: 1, icon: 'fa-triangle-exclamation', label: 'กรวยจราจร' },
  { key: 'warning_sign', num: 2, icon: 'fa-sign-hanging', label: 'ป้ายเตือน' },
  { key: 'flashing_light', num: 3, icon: 'fa-lightbulb', label: 'ไฟเตือน' },
  { key: 'barrier', num: 4, icon: 'fa-road-barrier', label: 'แผงกั้นเขตก่อสร้าง' },
  { key: 'lane_marking', num: 5, icon: 'fa-road', label: 'เส้นแบ่งช่องทาง' },
  { key: 'speed_limit_sign', num: 6, icon: 'fa-gauge-high', label: 'ป้ายจำกัดความเร็ว' },
  { key: 'detour', num: 7, icon: 'fa-diamond-turn-right', label: 'ทางเบี่ยง' },
  { key: 'construction_zone', num: 8, icon: 'fa-map-location-dot', label: 'เขตก่อสร้าง' },
];
const MOCK_PHOTO = 'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1200&q=75&auto=format&fit=crop';
const idText = Astro.params.id || '';
const id = Number(idText);
const validId = /^\d+$/.test(idText) && Number.isSafeInteger(id) && id > 0;
const session = getSession(Astro.cookies);
let project: Project | null = null;
let loadError = '';
if (validId) {
  const { data, error } = await supabase.from('projects').select('*').eq('legacy_id', id).maybeSingle();
  if (error) loadError = 'ไม่สามารถโหลดโครงการได้';
  else if (data) {
    const owner = data.extra?.ownerUsername;
    const allowed = session?.role === 'contractor' && Boolean(owner) && owner === session.username;
    if (allowed) project = rowToClient(data) as Project;
  }
}
if (!project) Astro.response.status = loadError ? 500 : 404;
const isPhoto = (value: unknown): value is string => typeof value === 'string' && (/^data:image\//.test(value) || /^https:\/\//.test(value));
const normalizePhotos = (value: unknown): string[] => Array.isArray(value) ? value.filter(isPhoto) : [];
const sitePhotos = normalizePhotos(project?.sitePhotos);
const siteGalleryPhotos = sitePhotos.length ? sitePhotos : [MOCK_PHOTO];
const cover = siteGalleryPhotos[0];
const checkpointPhotos = Object.fromEntries(
  CHECKPOINT_META.map(({ key }) => [key, normalizePhotos(project?.checkpointPhotos?.[key])])
);
const localizedWorkType = localizeWorkType(project?.workType);
const localizedRoad = localizeRoad(project?.roadName);
const statusKey = project && STATUS_LABELS[project.status || ''] ? project.status as string : 'planned';
const levelKey = project && LEVEL_LABELS[project.workLevel || ''] ? project.workLevel as string : 'medium';
const isCompleted = statusKey === 'completed';
const parseProjectDate = (value: unknown) => {
  if (!value) return null;
  const text = String(value).trim();
  const normalized = /^\d{4}-\d{2}-\d{2}$/.test(text)
    ? `${text}T00:00:00+07:00`
    : (/[zZ]$|[+-]\d{2}:\d{2}$/.test(text) ? text : `${text}+07:00`);
  const date = new Date(normalized);
  return Number.isNaN(date.getTime()) ? null : date;
};
const formatBangkokDateTime = (value: unknown) => {
  const date = parseProjectDate(value);
  return date ? new Intl.DateTimeFormat('th-TH', {
    timeZone: 'Asia/Bangkok', dateStyle: 'medium', timeStyle: 'medium',
  }).format(date) : '-';
};
const formatDuration = (milliseconds: number) => {
  const totalMinutes = Math.floor(Math.abs(milliseconds) / 60000);
  if (totalMinutes < 1) return 'น้อยกว่า 1 นาที';
  const days = Math.floor(totalMinutes / 1440);
  const hours = Math.floor((totalMinutes % 1440) / 60);
  const minutes = totalMinutes % 60;
  return [days && `${days} วัน`, hours && `${hours} ชั่วโมง`, minutes && `${minutes} นาที`].filter(Boolean).join(' ');
};
const completedDate = parseProjectDate(project?.completed_at);
const plannedEndDate = parseProjectDate(project?.end);
const scheduleDelta = completedDate && plannedEndDate ? completedDate.getTime() - plannedEndDate.getTime() : null;
const scheduleResult = scheduleDelta === null
  ? { className: 'unknown', text: isCompleted ? 'ไม่สามารถคำนวณได้ เนื่องจากไม่มีเวลาปิดงานหรือเวลาสิ้นสุดตามแผน' : '-' }
  : scheduleDelta === 0
    ? { className: 'on-time', text: 'เสร็จตรงตามกำหนด' }
    : scheduleDelta < 0
      ? { className: 'early', text: `เสร็จก่อนกำหนด ${formatDuration(scheduleDelta)}` }
      : { className: 'late', text: `เสร็จล่าช้ากว่ากำหนด ${formatDuration(scheduleDelta)}` };
const toInputDate = (value: unknown) => {
  if (!value) return '';
  const text = String(value);
  return text.includes('T') ? text.slice(0, 16) : `${text.slice(0, 10)}T00:00`;
};
---
<BaseLayout title={project?.name || 'รายละเอียดโครงการ'} role="contractor">
  <div class="mobile-page contractor-project-page">
    <header class="mobile-header">
      <a href="/contractor?section=projects" class="back-btn" aria-label="กลับไปโครงการของฉัน"><i class="fa-solid fa-arrow-left"></i></a>
      <div><h1>รายละเอียดโครงการ</h1><small>{project ? `โครงการเลขที่ ${project.id}` : 'ไม่พบโครงการ'}</small></div>
      <button id="logoutBtn" type="button" class="back-btn" aria-label="ออกจากระบบ" style="margin-left:auto"><i class="fa-solid fa-right-from-bracket"></i></button>
    </header>

    {!project ? (
      <main class="mobile-content contractor-project-main">
        <section class="card report-not-found">
          <i class="fa-solid fa-file-circle-xmark" style="font-size:2.4rem;color:var(--amber)"></i>
          <h2>{loadError || 'ไม่พบโครงการ หรือคุณไม่มีสิทธิ์เข้าถึง'}</h2>
          <a class="big-action contractor-back-link" href="/contractor?section=projects">กลับไปโครงการของฉัน</a>
        </section>
      </main>
    ) : (
      <main class="mobile-content contractor-project-main">
        <section class="contractor-project-hero card glass-panel">
          <div class="contractor-site-gallery" id="contractorSiteGallery" aria-label="อัลบั้มรูปถ่ายหน้างาน">
            <img id="contractorSiteGalleryImage" src={cover} alt={`รูปหน้างาน ${project.name || ''} รูปที่ 1`}>
            {sitePhotos.length === 0 && <span class="contractor-site-gallery-sample">ภาพตัวอย่าง</span>}
            <button class="listing-cover-arrow prev" id="contractorSiteGalleryPrev" type="button" aria-label="รูปก่อนหน้า" hidden={siteGalleryPhotos.length <= 1}><i class="fa-solid fa-chevron-left"></i></button>
            <button class="listing-cover-arrow next" id="contractorSiteGalleryNext" type="button" aria-label="รูปถัดไป" hidden={siteGalleryPhotos.length <= 1}><i class="fa-solid fa-chevron-right"></i></button>
            <span class="listing-cover-counter" id="contractorSiteGalleryCounter">1/{siteGalleryPhotos.length}</span>
          </div>
          <div class="contractor-project-heading">
            <div class="report-heading-meta">
              <span class={`report-meta-chip report-level-chip level-${levelKey}`}><i class="fa-solid fa-layer-group"></i> {LEVEL_LABELS[levelKey]}</span>
              <span class="report-meta-chip"><i class="fa-solid fa-helmet-safety"></i> {STATUS_LABELS[statusKey]}</span>
            </div>
            <h2>{project.name}</h2>
            <div class="project-rating-badge" data-project-rating-summary={project.id} aria-live="polite"><i class="fa-solid fa-star"></i> กำลังโหลดคะแนน...</div>
            <p><i class="fa-solid fa-road"></i> {localizedRoad} · {project.province || '-'}</p>
          </div>
        </section>

        <section class="report-section report-detail-card glass-panel">
          <h2 class="report-section-title"><i class="fa-solid fa-circle-info"></i> รายละเอียดโครงการ</h2>
          <dl class="detail-list report-detail-list">
            <dt>ประเภทงาน</dt><dd>{localizedWorkType}</dd>
            <dt>ถนน</dt><dd>{localizedRoad}</dd>
            <dt>จังหวัด</dt><dd>{project.province || '-'}</dd>
            <dt>สถานะ</dt><dd>{STATUS_LABELS[statusKey]}</dd>
            <dt>ระดับงาน</dt><dd>{LEVEL_LABELS[levelKey]}</dd>
            <dt>สิ้นสุดตามแผน</dt><dd>{formatBangkokDateTime(project.end)}</dd>
            {isCompleted && <><dt>เสร็จสิ้นจริง</dt><dd>{formatBangkokDateTime(project.completed_at)}</dd></>}
            {isCompleted && <><dt>เทียบกับแผน</dt><dd><span class={`completion-timing ${scheduleResult.className}`}>{scheduleResult.text}</span></dd></>}
            <dt>หมายเหตุ</dt><dd>{project.statusNote || '-'}</dd>
          </dl>
        </section>

        <section class="report-section report-detail-card glass-panel" aria-labelledby="contractor-checkpoint-title">
          <h2 class="report-section-title" id="contractor-checkpoint-title"><i class="fa-solid fa-list-check"></i> รูปตรวจมาตรฐาน 8 จุดสำคัญ</h2>
          <p class="contractor-gallery-help">{isCompleted ? 'โครงการเสร็จสิ้นแล้ว รูปทั้งหมดเป็นแบบอ่านอย่างเดียว' : 'แตะรูปเพื่อเปิดอัลบั้ม หรือแตะช่องว่างเพื่อเพิ่มรูปจากกล้องและคลังภาพ'}</p>
          <div class="checkpoint-albums-grid">
            {CHECKPOINT_META.map((meta) => {
              const photos = checkpointPhotos[meta.key];
              return <section class="checkpoint-album-group">
                <h3 class="checkpoint-album-title"><span class="checkpoint-num">{meta.num}</span><i class={`fa-solid ${meta.icon}`}></i> {meta.label}</h3>
                {photos.length ? (
                  <div class="checkpoint-album-strip" data-contractor-checkpoint={meta.key} aria-label={`อัลบั้ม${meta.label}`}>
                    {photos.map((src, index) => <button class="checkpoint-photo-button" type="button" data-contractor-photo-index={index} aria-label={`ขยายรูป ${meta.label} รูปที่ ${index + 1}`}><img src={src} alt={`${meta.label} รูปที่ ${index + 1}`} loading="lazy"></button>)}
                  </div>
                ) : isCompleted ? (
                  <div class="checkpoint-photo-placeholder is-locked" aria-label={`${meta.label} ไม่มีรูปแนบ`}>
                    <i class="fa-solid fa-lock"></i>
                    <span>ไม่มีรูปแนบ</span>
                    <small>โครงการเสร็จสิ้นและถูกล็อกแล้ว</small>
                  </div>
                ) : (
                  <button class="checkpoint-photo-placeholder" type="button" data-checkpoint-upload-trigger={meta.key} data-upload-source="gallery" aria-label={`เลือกรูปสำหรับ${meta.label}`}>
                    <i class="fa-regular fa-image"></i>
                    <span>ยังไม่มีรูป — แตะเพื่อเพิ่ม</span>
                    <small>เลือกจากคลังภาพหรือใช้ปุ่มถ่ายรูปด้านล่าง</small>
                  </button>
                )}
                {!isCompleted && <>
                  <div class="contractor-checkpoint-upload-actions">
                    <button type="button" class="contractor-checkpoint-upload-button camera" data-checkpoint-upload-trigger={meta.key} data-upload-source="camera"><i class="fa-solid fa-camera"></i> ถ่ายรูป</button>
                    <button type="button" class="contractor-checkpoint-upload-button gallery" data-checkpoint-upload-trigger={meta.key} data-upload-source="gallery"><i class="fa-solid fa-images"></i> เลือกรูป</button>
                  </div>
                  <input class="visually-hidden contractor-checkpoint-input" id={`contractor-${meta.key}-camera`} type="file" accept="image/*" capture="environment" data-checkpoint-key={meta.key}>
                  <input class="visually-hidden contractor-checkpoint-input" id={`contractor-${meta.key}-gallery`} type="file" accept="image/*" multiple data-checkpoint-key={meta.key}>
                  <p class="contractor-checkpoint-upload-status" data-checkpoint-status={meta.key} role="status" aria-live="polite"></p>
                </>}
              </section>;
            })}
          </div>
        </section>

        <ProjectReviews projectId={project.id} />

        <form class:list={{ 'card glass-panel contractor-project-form': true, 'is-readonly': isCompleted }} id="contractorProjectForm">
          <div class="contractor-form-title"><div><p class="eyebrow">{isCompleted ? 'READ ONLY' : 'EDIT PROJECT'}</p><h2>{isCompleted ? 'โครงการเสร็จสิ้นและล็อกแล้ว' : 'แก้ไขข้อมูลโครงการ'}</h2></div><i class={`fa-solid ${isCompleted ? 'fa-lock' : 'fa-pen-to-square'}`}></i></div>
          <fieldset class="contractor-project-fieldset" disabled={isCompleted}>
          <div class="card-grid">
            <label><span>ชื่องาน</span><input name="name" value={project.name || ''} required></label>
            <div class="card-grid two">
              <label><span>ประเภทงาน</span><select name="workType">
                {project.workType && !Object.prototype.hasOwnProperty.call(WORK_TYPE_LABELS, project.workType) && <option value={project.workType} selected>{localizedWorkType}</option>}
                {Object.entries(WORK_TYPE_LABELS).map(([value, label]) => <option value={value} selected={project.workType === value}>{label}</option>)}
              </select></label>
              <label><span>สถานะ</span><select name="status"><option value="in-progress" selected={statusKey === 'in-progress'}>กำลังทำ</option><option value="delayed" selected={statusKey === 'delayed'}>ล่าช้า</option><option value="planned" selected={statusKey === 'planned'}>วางแผน</option><option value="completed" selected={statusKey === 'completed'}>เสร็จสิ้น</option></select></label>
            </div>
            <label><span>ระดับงานก่อสร้าง</span><select name="workLevel"><option value="critical" selected={levelKey === 'critical'}>ระดับ 1 — วิกฤต</option><option value="high" selected={levelKey === 'high'}>ระดับ 2 — สูง</option><option value="medium" selected={levelKey === 'medium'}>ระดับ 3 — ปานกลาง</option><option value="routine" selected={levelKey === 'routine'}>ระดับ 4 — ทั่วไป</option></select></label>
            <label><span>ถนน</span><input name="roadName" value={localizedRoad === '-' ? '' : localizedRoad}></label>
            <div class="card-grid two">
              <label><span>ละติจูด</span><input name="lat" type="number" step="0.000001" value={project.lat}></label>
              <label><span>ลองจิจูด</span><input name="lng" type="number" step="0.000001" value={project.lng}></label>
            </div>
            <div class="card-grid two">
              <label><span>เริ่มงาน</span><input name="start" type="datetime-local" value={toInputDate(project.start)}></label>
              <label><span>สิ้นสุด</span><input name="end" type="datetime-local" value={toInputDate(project.end)}></label>
            </div>
            <label><span>ขอบเขต (เมตร)</span><input name="boundaryMeters" type="number" min="40" max="900" step="10" value={project.boundaryMeters || 280}></label>
            <label><span>หมายเหตุ</span><textarea name="statusNote" rows="3">{project.statusNote || ''}</textarea></label>
          </div>
          </fieldset>
          <p class="completion-warning" id="completionWarning" hidden={!isCompleted}><i class="fa-solid fa-triangle-exclamation"></i> ไม่สามารถแก้ไขข้อมูลได้หลังจากเลือกสถานะเสร็จสิ้นงาน</p>
          <p class="contractor-form-message" id="contractorProjectMessage" role="status" aria-live="polite"></p>
          {isCompleted ? (
            <div class="completion-locked-notice"><i class="fa-solid fa-lock"></i><span>ข้อมูลโครงการนี้ถูกล็อกถาวรแล้ว</span></div>
          ) : (
            <div class="contractor-project-actions">
              <button class="big-action" id="saveContractorProject" type="submit"><i class="fa-solid fa-floppy-disk"></i> บันทึกการแก้ไข</button>
              <button class="contractor-delete-action" id="deleteContractorProject" type="button"><i class="fa-solid fa-trash"></i> ลบโครงการ</button>
            </div>
          )}
        </form>
      </main>
    )}
  </div>

  {project && (
    <div class="image-lightbox" id="contractorProjectLightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="ดูรูปแบบเต็มจอ">
      <button class="lightbox-close" id="contractorProjectLightboxClose" type="button" aria-label="ปิด"><i class="fa-solid fa-xmark"></i></button>
      <button class="lightbox-arrow prev" id="contractorProjectLightboxPrev" type="button" aria-label="รูปก่อนหน้า"><i class="fa-solid fa-chevron-left"></i></button>
      <img id="contractorProjectLightboxImg" alt="รูปโครงการแบบเต็มจอ">
      <button class="lightbox-arrow next" id="contractorProjectLightboxNext" type="button" aria-label="รูปถัดไป"><i class="fa-solid fa-chevron-right"></i></button>
      <span class="lightbox-counter" id="contractorProjectLightboxCounter">1/1</span>
    </div>
  )}

  {project && <script is:inline define:vars={{ projectId: project.id, projectIsCompleted: isCompleted, checkpointGalleryData: checkpointPhotos, siteGalleryData: siteGalleryPhotos }}>
    const form = document.getElementById('contractorProjectForm');
    const message = document.getElementById('contractorProjectMessage');
    const saveButton = document.getElementById('saveContractorProject');
    const deleteButton = document.getElementById('deleteContractorProject');
    const statusSelect = form?.querySelector('select[name="status"]');
    const completionWarning = document.getElementById('completionWarning');
    statusSelect?.addEventListener('change', () => {
      if (completionWarning) completionWarning.hidden = statusSelect.value !== 'completed';
    });
    const lightbox = document.getElementById('contractorProjectLightbox');
    const lightboxImage = document.getElementById('contractorProjectLightboxImg');
    const lightboxCounter = document.getElementById('contractorProjectLightboxCounter');
    const lightboxPrevious = document.getElementById('contractorProjectLightboxPrev');
    const lightboxNext = document.getElementById('contractorProjectLightboxNext');
    const siteGallery = document.getElementById('contractorSiteGallery');
    const siteGalleryImage = document.getElementById('contractorSiteGalleryImage');
    const siteGalleryCounter = document.getElementById('contractorSiteGalleryCounter');
    const siteGalleryPrevious = document.getElementById('contractorSiteGalleryPrev');
    const siteGalleryNext = document.getElementById('contractorSiteGalleryNext');
    let siteGalleryIndex = 0;
    let activeAlbum = [];
    let activePhotoIndex = 0;

    function renderProjectLightbox() {
      if (!activeAlbum.length || !lightboxImage) return;
      lightboxImage.src = activeAlbum[activePhotoIndex];
      lightboxCounter.textContent = `${activePhotoIndex + 1}/${activeAlbum.length}`;
      const hasMultiple = activeAlbum.length > 1;
      lightboxPrevious.hidden = !hasMultiple;
      lightboxNext.hidden = !hasMultiple;
    }

    function openProjectLightbox(photos, index) {
      if (!Array.isArray(photos) || photos.length === 0) return;
      activeAlbum = photos;
      activePhotoIndex = Math.max(0, Math.min(index, photos.length - 1));
      renderProjectLightbox();
      lightbox.classList.add('visible');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.classList.add('lightbox-open');
      document.getElementById('contractorProjectLightboxClose')?.focus();
    }

    function closeProjectLightbox() {
      lightbox?.classList.remove('visible');
      lightbox?.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('lightbox-open');
    }

    function changeProjectLightbox(step) {
      if (activeAlbum.length < 2) return;
      activePhotoIndex = (activePhotoIndex + step + activeAlbum.length) % activeAlbum.length;
      renderProjectLightbox();
    }

    function renderSiteGallery() {
      if (!siteGalleryImage || !siteGalleryData.length) return;
      siteGalleryImage.src = siteGalleryData[siteGalleryIndex];
      siteGalleryImage.alt = `รูปถ่ายหน้างาน รูปที่ ${siteGalleryIndex + 1}`;
      if (siteGalleryCounter) siteGalleryCounter.textContent = `${siteGalleryIndex + 1}/${siteGalleryData.length}`;
    }

    function changeSiteGallery(step) {
      if (siteGalleryData.length < 2) return;
      siteGalleryIndex = (siteGalleryIndex + step + siteGalleryData.length) % siteGalleryData.length;
      renderSiteGallery();
    }

    siteGalleryPrevious?.addEventListener('click', () => changeSiteGallery(-1));
    siteGalleryNext?.addEventListener('click', () => changeSiteGallery(1));
    siteGalleryImage?.addEventListener('click', () => openProjectLightbox(siteGalleryData, siteGalleryIndex));

    document.querySelectorAll('[data-contractor-checkpoint]').forEach((album) => {
      const photos = checkpointGalleryData?.[album.dataset.contractorCheckpoint] || [];
      album.querySelectorAll('[data-contractor-photo-index]').forEach((button) => {
        button.addEventListener('click', () => openProjectLightbox(photos, Number(button.dataset.contractorPhotoIndex)));
      });
    });
    document.getElementById('contractorProjectLightboxClose')?.addEventListener('click', closeProjectLightbox);
    lightboxPrevious?.addEventListener('click', () => changeProjectLightbox(-1));
    lightboxNext?.addEventListener('click', () => changeProjectLightbox(1));
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeProjectLightbox();
    });
    document.addEventListener('keydown', (event) => {
      if (!lightbox?.classList.contains('visible')) return;
      if (event.key === 'Escape') closeProjectLightbox();
      if (event.key === 'ArrowLeft') changeProjectLightbox(-1);
      if (event.key === 'ArrowRight') changeProjectLightbox(1);
    });

    let swipeStartX = 0;
    let swipeStartY = 0;
    lightbox?.addEventListener('touchstart', (event) => {
      swipeStartX = event.changedTouches[0].clientX;
      swipeStartY = event.changedTouches[0].clientY;
    }, { passive: true });
    lightbox?.addEventListener('touchend', (event) => {
      const deltaX = event.changedTouches[0].clientX - swipeStartX;
      const deltaY = event.changedTouches[0].clientY - swipeStartY;
      if (Math.abs(deltaX) < 45 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
      changeProjectLightbox(deltaX < 0 ? 1 : -1);
    }, { passive: true });

    let siteSwipeStartX = 0;
    let siteSwipeStartY = 0;
    siteGallery?.addEventListener('touchstart', (event) => {
      siteSwipeStartX = event.changedTouches[0].clientX;
      siteSwipeStartY = event.changedTouches[0].clientY;
    }, { passive: true });
    siteGallery?.addEventListener('touchend', (event) => {
      const deltaX = event.changedTouches[0].clientX - siteSwipeStartX;
      const deltaY = event.changedTouches[0].clientY - siteSwipeStartY;
      if (Math.abs(deltaX) < 45 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
      changeSiteGallery(deltaX < 0 ? 1 : -1);
    }, { passive: true });

    function fileToDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(new Error('ไม่สามารถอ่านไฟล์รูปได้'));
        reader.readAsDataURL(file);
      });
    }

    async function readCheckpointFile(file) {
      const source = await fileToDataUrl(file);
      if (!file.type.startsWith('image/') || file.size <= 450000) return source;

      const image = await new Promise((resolve, reject) => {
        const element = new Image();
        element.onload = () => resolve(element);
        element.onerror = () => reject(new Error('ไม่สามารถปรับขนาดรูปได้'));
        element.src = source;
      });
      const maxDimension = 1600;
      const scale = Math.min(1, maxDimension / Math.max(image.naturalWidth, image.naturalHeight));
      const canvas = document.createElement('canvas');
      canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
      canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
      const context = canvas.getContext('2d');
      context.fillStyle = '#ffffff';
      context.fillRect(0, 0, canvas.width, canvas.height);
      context.drawImage(image, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/jpeg', 0.82);
    }

    function notifyProjectPhotoUpdate() {
      try {
        if ('BroadcastChannel' in window) {
          const channel = new BroadcastChannel('chalui-projects');
          channel.postMessage({ type: 'project-updated', id: projectId });
          channel.close();
        }
        localStorage.setItem('chalui-project-updated', `${projectId}:${Date.now()}`);
      } catch (error) {
        console.warn('Project photo update notification was unavailable:', error);
      }
    }

    document.querySelectorAll('[data-checkpoint-upload-trigger]').forEach((button) => {
      button.addEventListener('click', () => {
        const key = button.dataset.checkpointUploadTrigger;
        const source = button.dataset.uploadSource || 'gallery';
        document.getElementById(`contractor-${key}-${source}`)?.click();
      });
    });

    document.querySelectorAll('.contractor-checkpoint-input').forEach((input) => {
      input.addEventListener('change', async () => {
        const key = input.dataset.checkpointKey;
        const files = Array.from(input.files || []);
        if (!key || files.length === 0) return;

        const group = input.closest('.checkpoint-album-group');
        const status = group?.querySelector(`[data-checkpoint-status="${key}"]`);
        const actionButtons = group?.querySelectorAll('[data-checkpoint-upload-trigger]') || [];
        group?.classList.add('is-uploading');
        actionButtons.forEach((button) => { button.disabled = true; });
        if (status) {
          status.textContent = 'กำลังอัปโหลดรูป...';
          status.className = 'contractor-checkpoint-upload-status uploading';
        }

        try {
          const newPhotos = await Promise.all(files.map(readCheckpointFile));
          const updatedCheckpointPhotos = {
            ...checkpointGalleryData,
            [key]: [...(checkpointGalleryData[key] || []), ...newPhotos],
          };
          const response = await fetch('/api/projects', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: projectId, checkpointPhotos: updatedCheckpointPhotos }),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'อัปโหลดรูปไม่สำเร็จ');
          checkpointGalleryData[key] = updatedCheckpointPhotos[key];
          notifyProjectPhotoUpdate();
          if (status) {
            status.textContent = 'เพิ่มรูปเรียบร้อยแล้ว';
            status.className = 'contractor-checkpoint-upload-status success';
          }
          window.setTimeout(() => window.location.reload(), 500);
        } catch (error) {
          group?.classList.remove('is-uploading');
          actionButtons.forEach((button) => { button.disabled = false; });
          if (status) {
            status.textContent = error.message || 'อัปโหลดรูปไม่สำเร็จ';
            status.className = 'contractor-checkpoint-upload-status error';
          }
        } finally {
          input.value = '';
        }
      });
    });

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (projectIsCompleted) return;
      const data = new FormData(form);
      const payload = {
        id: projectId,
        name: String(data.get('name') || '').trim(),
        workType: String(data.get('workType') || '').trim(),
        status: String(data.get('status') || 'planned'),
        workLevel: String(data.get('workLevel') || 'medium'),
        roadName: String(data.get('roadName') || '').trim(),
        lat: Number(data.get('lat')),
        lng: Number(data.get('lng')),
        start: String(data.get('start') || ''),
        end: String(data.get('end') || ''),
        boundaryMeters: Number(data.get('boundaryMeters')),
        statusNote: String(data.get('statusNote') || '').trim(),
      };
      if (!payload.name || !Number.isFinite(payload.lat) || !Number.isFinite(payload.lng)) {
        message.textContent = 'กรุณากรอกชื่อโครงการและพิกัดให้ถูกต้อง';
        message.className = 'contractor-form-message error';
        return;
      }
      if (payload.status === 'completed' && !window.confirm('ยืนยันสถานะเสร็จสิ้นงาน? หลังบันทึกแล้วจะไม่สามารถแก้ไข อัปโหลดรูป หรือลบโครงการได้')) {
        return;
      }
      saveButton.disabled = true;
      message.textContent = 'กำลังบันทึก...';
      message.className = 'contractor-form-message';
      try {
        const response = await fetch('/api/projects', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'บันทึกไม่สำเร็จ');
        message.textContent = 'บันทึกการแก้ไขเรียบร้อยแล้ว';
        message.className = 'contractor-form-message success';
        window.setTimeout(() => window.location.reload(), 650);
      } catch (error) {
        message.textContent = error.message;
        message.className = 'contractor-form-message error';
        saveButton.disabled = false;
      }
    });
    deleteButton?.addEventListener('click', async () => {
      const confirmed = window.confirm('ต้องการลบโครงการนี้ใช่หรือไม่? การลบไม่สามารถย้อนกลับได้');
      if (!confirmed) return;
      deleteButton.disabled = true;
      saveButton.disabled = true;
      message.textContent = 'กำลังลบโครงการ...';
      message.className = 'contractor-form-message';
      try {
        const response = await fetch('/api/projects', { method: 'DELETE', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: projectId }) });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'ลบไม่สำเร็จ');
        window.location.href = '/contractor?section=projects';
      } catch (error) {
        message.textContent = error.message;
        message.className = 'contractor-form-message error';
        deleteButton.disabled = false;
        saveButton.disabled = false;
      }
    });
  </script>}
</BaseLayout>
