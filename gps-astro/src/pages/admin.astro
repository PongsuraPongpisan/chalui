---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="เจ้าหน้าที่ ทล." role="admin">
  <div class="mobile-page">
    <header class="mobile-header">
      <a href="/" class="back-btn" aria-label="กลับ"><i class="fa-solid fa-arrow-left"></i></a>
      <div>
        <h1>DOH Admin</h1>
        <small>ตรวจมาตรฐาน & อนุมัติงาน</small>
      </div>
      <button id="logoutBtn" type="button" class="back-btn" aria-label="ออกจากระบบ" style="margin-left:auto"><i class="fa-solid fa-right-from-bracket"></i></button>
    </header>

    <div class="mobile-content">
      <div class="segment-tabs">
        <button class="active" data-section="sec-ai" type="button">🏗️ รายงานก่อสร้าง</button>
        <button data-section="sec-queue" type="button">💬 รายงานประชาชน</button>
        <button data-section="sec-kpi" type="button">🏢 บริษัท</button>
      </div>

      <!-- Construction Reports section -->
      <section id="sec-ai">
        <!-- Work level overview (ระดับงาน) -->
        <div class="card glass-panel" style="border-left: 4px solid var(--amber);">
          <h3 style="color: var(--amber);"><i class="fa-solid fa-layer-group"></i> ระดับงานก่อสร้างในระบบ</h3>
          <p style="font-size:0.8rem;color:#68746f;margin:-4px 0 12px">จัดระดับตามความเสี่ยง/ผลกระทบจราจร — แตะการ์ดเพื่อกรองรายงานตามระดับ</p>
          <div id="workLevelOverview" style="display:grid;grid-template-columns:repeat(2,1fr);gap:10px"></div>
        </div>

        <div class="card glass-panel" style="border-left: 4px solid var(--teal);">
          <h3 style="color: var(--teal);"><i class="fa-solid fa-helmet-safety"></i> รายงานก่อสร้างทั้งหมด</h3>
          <p style="font-size:0.8rem;color:#68746f;margin:-4px 0 12px">รายงานพื้นที่ก่อสร้างที่ผู้รับเหมาส่งเข้ามา — แตะเพื่อดูรายละเอียดและรูปถ่าย</p>
          <div id="constructionReportList"></div>
        </div>
      </section>

      <!-- Citizen Reports section -->
      <section id="sec-queue" class="section-hidden">
        <div class="card glass-panel" style="border-left: 4px solid var(--amber);">
          <h3 style="color: var(--amber);"><i class="fa-solid fa-comments"></i> รายงานจากประชาชน</h3>
          <p style="font-size:0.8rem;color:#68746f;margin:-4px 0 12px">รายงานปัญหาและ feedback ที่ประชาชนส่งเข้ามา — แตะเพื่อดูรายละเอียด</p>
          <div id="citizenReportList"></div>
        </div>
      </section>

      <!-- Company Directory section -->
      <section id="sec-kpi" class="section-hidden">
        <div class="card glass-panel" style="border-left: 4px solid var(--blue);">
          <h3 style="color: var(--blue);"><i class="fa-solid fa-building"></i> บริษัทผู้รับเหมา</h3>
          <p style="font-size:0.8rem;color:#68746f;margin:-4px 0 12px">รายชื่อบริษัทผู้รับเหมาและโครงการที่รับผิดชอบ — แตะเพื่อดูรายละเอียด</p>
          <div id="companyList"></div>
        </div>
      </section>

      <div class="toast" id="toast" role="status" aria-live="polite"></div>

      <!-- Construction report detail — full page view (not a popup) -->
      <section class="admin-page-view" id="reportDetailPage" aria-hidden="true">
        <header class="admin-page-header">
          <button class="back-btn" id="closeReportDetail" type="button" aria-label="กลับ"><i class="fa-solid fa-arrow-left"></i></button>
          <p class="eyebrow">รายงานก่อสร้าง</p>
        </header>
        <div class="admin-page-body">
          <div class="listing-cover" id="reportCoverWrap">
            <span class="listing-badge" id="reportCoverBadge">-</span>
            <img class="listing-cover-img" id="reportCoverImg" alt="รูปหน้างาน">
            <button class="listing-cover-arrow" id="reportCoverNext" type="button" aria-label="รูปถัดไป"><i class="fa-solid fa-chevron-right"></i></button>
            <span class="listing-cover-counter" id="reportCoverCounter">0/0</span>
          </div>
          <h2 class="listing-title" id="reportDetailName">-</h2>
          <p class="listing-location"><i class="fa-solid fa-location-dot"></i> <span id="reportDetailRoad">-</span></p>
          <dl class="detail-list">
            <dt>ผู้รับเหมา</dt><dd id="reportDetailContractor">-</dd>
            <dt>GPS</dt><dd id="reportDetailGps">-</dd>
            <dt>สถานะ</dt><dd id="reportDetailStatus">-</dd>
            <dt>เริ่ม</dt><dd id="reportDetailStart">-</dd>
            <dt>สิ้นสุด</dt><dd id="reportDetailEnd">-</dd>
            <dt>หมายเหตุ</dt><dd id="reportDetailNote">-</dd>
          </dl>
        </div>
      </section>

      <!-- Citizen report detail modal -->
      <section class="detail-modal" id="citizenDetailModal" aria-hidden="true">
        <div class="detail-panel">
          <header class="detail-header">
            <div><p class="eyebrow">รายงานประชาชน</p><h2 id="citizenDetailTitle">-</h2></div>
            <button class="panel-toggle" id="closeCitizenDetail" type="button">X</button>
          </header>
          <div class="detail-body">
            <div class="detail-photo-grid" id="citizenDetailPhotos"></div>
            <dl class="detail-list">
              <dt>ประเภท</dt><dd id="citizenDetailType">-</dd>
              <dt>รายละเอียด</dt><dd id="citizenDetailDescription">-</dd>
              <dt>โครงการ</dt><dd id="citizenDetailZone">-</dd>
              <dt>GPS</dt><dd id="citizenDetailGps">-</dd>
              <dt>เวลา</dt><dd id="citizenDetailTime">-</dd>
              <dt>ผู้แจ้ง</dt><dd id="citizenDetailReporter">-</dd>
            </dl>
          </div>
        </div>
      </section>

      <!-- Company detail modal -->
      <section class="detail-modal" id="companyDetailModal" aria-hidden="true">
        <div class="detail-panel">
          <header class="detail-header">
            <div><p class="eyebrow">บริษัท</p><h2 id="companyDetailName">-</h2></div>
            <button class="panel-toggle" id="closeCompanyDetail" type="button">X</button>
          </header>
          <div class="detail-body">
            <dl class="detail-list">
              <dt>โครงการทั้งหมด</dt><dd id="companyDetailTotal">-</dd>
              <dt>กำลังดำเนินการ</dt><dd id="companyDetailActive">-</dd>
            </dl>
            <div id="companyDetailProjects"></div>
          </div>
        </div>
      </section>
    </div>

    <nav class="mobile-bottom-nav glass-panel" style="border-top-left-radius: 24px; border-top-right-radius: 24px; overflow: hidden; padding-bottom: calc(env(safe-area-inset-bottom) + 8px);">
      <a href="/" class="hover-scale"><i class="fa-solid fa-arrow-left"></i><span>เลือก role</span></a>
      <button class="active hover-scale" data-section="sec-ai" type="button"><i class="fa-solid fa-helmet-safety"></i><span>รายงานก่อสร้าง</span></button>
      <button class="hover-scale" data-section="sec-queue" type="button"><i class="fa-solid fa-comments"></i><span>รายงานประชาชน</span></button>
      <button class="hover-scale" data-section="sec-kpi" type="button"><i class="fa-solid fa-building"></i><span>บริษัท</span></button>
    </nav>
  </div>

  <script is:inline>
    // Section switcher (both segment tabs and bottom nav share data-section)
    function showAdminSection(id) {
      document.querySelectorAll('#sec-ai, #sec-queue, #sec-kpi').forEach((s) => s.classList.add('section-hidden'));
      const el = document.getElementById(id);
      if (el) el.classList.remove('section-hidden');
      document.querySelectorAll('[data-section]').forEach((b) => b.classList.toggle('active', b.dataset.section === id));
      // Leaving the tabs closes any open full-page detail view
      document.getElementById('reportDetailPage')?.classList.remove('visible');
      if (id === 'sec-ai' && window.AdminModule) window.AdminModule.renderConstructionReports();
      if (id === 'sec-queue' && window.AdminModule) window.AdminModule.renderCitizenReports();
      if (id === 'sec-kpi' && window.AdminModule) window.AdminModule.renderCompanyList();
    }
    document.querySelectorAll('[data-section]').forEach((btn) => {
      btn.addEventListener('click', () => showAdminSection(btn.dataset.section));
    });
    // initial populate
    window.addEventListener('load', () => {
      if (window.AdminModule) window.AdminModule.renderConstructionReports();
    });
  </script>
</BaseLayout>
