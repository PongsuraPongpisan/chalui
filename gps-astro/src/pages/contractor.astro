---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="ผู้รับเหมา" role="contractor">
  <div class="mobile-page">
    <header class="mobile-header">
      <a href="/" class="back-btn" aria-label="กลับ"><i class="fa-solid fa-arrow-left"></i></a>
      <div>
        <h1>ผู้รับเหมา</h1>
        <small>รายงานพื้นที่ก่อสร้าง</small>
      </div>
      <button id="logoutBtn" type="button" class="back-btn" aria-label="ออกจากระบบ" style="margin-left:auto"><i class="fa-solid fa-right-from-bracket"></i></button>
    </header>

    <div class="mobile-content">
      <!-- Section: New report form -->
      <section id="sec-form">
        <div class="mini-map"><div id="map"></div></div>

        <div class="card glass-panel" style="margin-top:14px; border-left: 4px solid var(--amber);">
          <h3 style="color: var(--amber);"><i class="fa-solid fa-helmet-safety"></i> เพิ่มงานก่อสร้างใหม่</h3>
          <div class="card-grid">
            <label><span>ชื่องาน</span><input id="constructionName" type="text" placeholder="เช่น ปรับผิวจราจรช่วงทางแยก"></label>
            <div class="card-grid two">
              <label><span>ประเภทงาน</span><select id="constructionType"><option value="Road resurfacing">ซ่อมผิวจราจร</option><option value="Drainage">ระบบระบายน้ำ</option><option value="Utility relocation">ย้ายสาธารณูปโภค</option><option value="Bridge repair">ซ่อมสะพาน</option><option value="Signal upgrade">ปรับสัญญาณ</option></select></label>
              <label><span>สถานะ</span><select id="constructionStatus"><option value="in-progress">กำลังทำ</option><option value="delayed">ล่าช้า</option><option value="planned">วางแผน</option><option value="completed">เสร็จสิ้น</option></select></label>
            </div>
            <fieldset class="construction-level-picker">
              <legend>
                <span class="construction-level-title"><i class="fa-solid fa-layer-group"></i> ระดับงานก่อสร้าง</span>
                <small>เลือกระดับตามความเสี่ยงและผลกระทบต่อการจราจร</small>
              </legend>
              <div class="construction-level-options" role="radiogroup" aria-label="ระดับงานก่อสร้าง">
                <button class="construction-level-option level-critical" type="button" role="radio" aria-checked="false" tabindex="-1" data-construction-level="critical">
                  <span class="construction-level-option-head"><span class="level-color-dot"></span><span>ระดับ 1</span><i class="fa-solid fa-circle-check"></i></span>
                  <strong>วิกฤต</strong><small>ตรวจเข้มพิเศษ</small>
                </button>
                <button class="construction-level-option level-high" type="button" role="radio" aria-checked="false" tabindex="-1" data-construction-level="high">
                  <span class="construction-level-option-head"><span class="level-color-dot"></span><span>ระดับ 2</span><i class="fa-solid fa-circle-check"></i></span>
                  <strong>สูง</strong><small>ตรวจเข้ม 8 กฎเต็ม</small>
                </button>
                <button class="construction-level-option level-medium is-selected" type="button" role="radio" aria-checked="true" tabindex="0" data-construction-level="medium">
                  <span class="construction-level-option-head"><span class="level-color-dot"></span><span>ระดับ 3</span><i class="fa-solid fa-circle-check"></i></span>
                  <strong>ปานกลาง</strong><small>ตรวจมาตรฐาน</small>
                </button>
                <button class="construction-level-option level-routine" type="button" role="radio" aria-checked="false" tabindex="-1" data-construction-level="routine">
                  <span class="construction-level-option-head"><span class="level-color-dot"></span><span>ระดับ 4</span><i class="fa-solid fa-circle-check"></i></span>
                  <strong>ทั่วไป</strong><small>ตรวจพื้นฐาน</small>
                </button>
              </div>
              <select id="constructionWorkLevel" class="visually-hidden" aria-hidden="true" tabindex="-1">
                <option value="critical">ระดับ 1 — วิกฤต</option><option value="high">ระดับ 2 — สูง</option><option value="medium" selected>ระดับ 3 — ปานกลาง</option><option value="routine">ระดับ 4 — ทั่วไป</option>
              </select>
            </fieldset>
            <label><span>ถนน</span><select id="constructionRoad"></select></label>
            <div class="card-grid two">
              <label><span>ละติจูด</span><input id="constructionLat" type="number" step="0.000001"></label>
              <label><span>ลองจิจูด</span><input id="constructionLng" type="number" step="0.000001"></label>
            </div>
            <div class="card-grid two">
              <label><span>เริ่มงาน</span><input id="constructionStart" type="datetime-local"></label>
              <label><span>สิ้นสุด</span><input id="constructionEnd" type="datetime-local"></label>
            </div>
            <div class="card-grid two">
              <label><span>ขอบเขต (ม.)</span><input id="constructionBoundary" type="number" min="40" max="900" step="10" value="280"></label>
              <label><span>หมายเหตุ</span><input id="constructionStatusNote" type="text" placeholder="เช่น ปิด 1 ช่อง"></label>
            </div>
          </div>
        </div>

        <div class="card glass-panel" style="border-left: 4px solid var(--teal);">
          <h3 style="color: var(--teal);"><i class="fa-solid fa-camera"></i> รูปถ่ายหน้างาน</h3>
          <p style="font-size:0.82rem;color:var(--muted);margin-bottom:12px">ถ่ายรูปสภาพหน้างานเพื่อส่งตรวจ AI</p>
          <div class="photo-upload-area">
            <label class="camera-button" for="contractorPhotoCamera">
              <i class="fa-solid fa-camera"></i>
              <span>ถ่ายรูป</span>
            </label>
            <label class="gallery-button" for="contractorPhotoGallery">
              <i class="fa-solid fa-images"></i>
              <span>เลือกรูป</span>
            </label>
            <input id="contractorPhotoCamera" class="visually-hidden" type="file" accept="image/*" capture="environment">
            <input id="contractorPhotoGallery" class="visually-hidden" type="file" accept="image/*" multiple>
          </div>
          <div class="checkpoint-thumbs" id="contractorPhotoThumbs" style="margin-top:10px"></div>
        </div>

        <div class="card glass-panel" style="border-left: 4px solid var(--teal);">
          <h3 style="color: var(--teal);"><i class="fa-solid fa-list-check"></i> รูปตรวจมาตรฐาน — 8 จุดสำคัญ</h3>
          <p style="font-size:0.82rem;color:var(--muted);margin-bottom:4px">ถ่ายหรือเลือกรูปจากคลังภาพได้หลายรูปต่อจุด — ไม่บังคับ ส่งงานได้แม้ไม่มีรูป</p>
          <p style="font-size:0.78rem;color:var(--teal);font-weight:600;margin-bottom:12px" id="checkpointProgress">แนบรูปแล้ว 0/8 จุด</p>
          <div class="checkpoint-grid" id="checkpointGrid">
            <div class="checkpoint-card" data-checkpoint="cone">
              <div class="checkpoint-head"><span class="checkpoint-num">1</span><i class="fa-solid fa-triangle-exclamation"></i><span>กรวยจราจร</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-cone-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-cone-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-cone-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="cone">
              <input id="checkpoint-cone-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="cone">
              <div class="checkpoint-thumbs" data-thumbs="cone"></div>
            </div>
            <div class="checkpoint-card" data-checkpoint="warning_sign">
              <div class="checkpoint-head"><span class="checkpoint-num">2</span><i class="fa-solid fa-sign-hanging"></i><span>ป้ายเตือน</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-warning_sign-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-warning_sign-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-warning_sign-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="warning_sign">
              <input id="checkpoint-warning_sign-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="warning_sign">
              <div class="checkpoint-thumbs" data-thumbs="warning_sign"></div>
            </div>
            <div class="checkpoint-card" data-checkpoint="flashing_light">
              <div class="checkpoint-head"><span class="checkpoint-num">3</span><i class="fa-solid fa-lightbulb"></i><span>ไฟเตือน</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-flashing_light-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-flashing_light-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-flashing_light-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="flashing_light">
              <input id="checkpoint-flashing_light-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="flashing_light">
              <div class="checkpoint-thumbs" data-thumbs="flashing_light"></div>
            </div>
            <div class="checkpoint-card" data-checkpoint="barrier">
              <div class="checkpoint-head"><span class="checkpoint-num">4</span><i class="fa-solid fa-road-barrier"></i><span>แผงกั้นเขตก่อสร้าง</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-barrier-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-barrier-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-barrier-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="barrier">
              <input id="checkpoint-barrier-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="barrier">
              <div class="checkpoint-thumbs" data-thumbs="barrier"></div>
            </div>
            <div class="checkpoint-card" data-checkpoint="lane_marking">
              <div class="checkpoint-head"><span class="checkpoint-num">5</span><i class="fa-solid fa-road"></i><span>เส้นแบ่งช่องทาง</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-lane_marking-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-lane_marking-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-lane_marking-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="lane_marking">
              <input id="checkpoint-lane_marking-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="lane_marking">
              <div class="checkpoint-thumbs" data-thumbs="lane_marking"></div>
            </div>
            <div class="checkpoint-card" data-checkpoint="speed_limit_sign">
              <div class="checkpoint-head"><span class="checkpoint-num">6</span><i class="fa-solid fa-gauge-high"></i><span>ป้ายจำกัดความเร็ว</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-speed_limit_sign-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-speed_limit_sign-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-speed_limit_sign-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="speed_limit_sign">
              <input id="checkpoint-speed_limit_sign-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="speed_limit_sign">
              <div class="checkpoint-thumbs" data-thumbs="speed_limit_sign"></div>
            </div>
            <div class="checkpoint-card" data-checkpoint="detour">
              <div class="checkpoint-head"><span class="checkpoint-num">7</span><i class="fa-solid fa-diamond-turn-right"></i><span>ทางเบี่ยง</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-detour-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-detour-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-detour-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="detour">
              <input id="checkpoint-detour-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="detour">
              <div class="checkpoint-thumbs" data-thumbs="detour"></div>
            </div>
            <div class="checkpoint-card" data-checkpoint="construction_zone">
              <div class="checkpoint-head"><span class="checkpoint-num">8</span><i class="fa-solid fa-map-location-dot"></i><span>เขตก่อสร้าง</span></div>
              <div class="checkpoint-actions">
                <label class="checkpoint-btn cam" for="checkpoint-construction_zone-camera"><i class="fa-solid fa-camera"></i> ถ่าย</label>
                <label class="checkpoint-btn gal" for="checkpoint-construction_zone-gallery"><i class="fa-solid fa-images"></i> เลือก</label>
              </div>
              <input id="checkpoint-construction_zone-camera" class="visually-hidden checkpoint-input" type="file" accept="image/*" capture="environment" data-checkpoint="construction_zone">
              <input id="checkpoint-construction_zone-gallery" class="visually-hidden checkpoint-input" type="file" accept="image/*" multiple data-checkpoint="construction_zone">
              <div class="checkpoint-thumbs" data-thumbs="construction_zone"></div>
            </div>
          </div>
        </div>

        <button class="big-action hover-scale" id="addConstruction" type="button" style="background: var(--amber); color: #fff; border: none; box-shadow: var(--shadow-md);"><i class="fa-solid fa-plus"></i> ส่งรายงานพื้นที่</button>
      </section>

      <!-- Section: My projects list -->
      <section id="sec-projects" class="section-hidden">
        <div class="card glass-panel" style="border-left: 4px solid var(--blue);">
          <h3 style="color: var(--blue);"><i class="fa-solid fa-list"></i> โครงการของฉัน</h3>
          <div class="filter-row" role="tablist">
            <button class="filter-chip active" data-filter="all" type="button">ทั้งหมด</button>
            <button class="filter-chip" data-filter="in-progress" type="button">กำลังทำ</button>
            <button class="filter-chip" data-filter="delayed" type="button">ล่าช้า</button>
            <button class="filter-chip" data-filter="planned" type="button">วางแผน</button>
          </div>
          <section class="project-list" id="projectList" style="margin-top:12px"></section>
        </div>
      </section>

      <div class="toast" id="toast" role="status" aria-live="polite"></div>

      <!-- hidden detail modal for openProjectDetail() compatibility -->
      <section class="detail-modal" id="detailModal" aria-hidden="true">
        <div class="detail-panel">
          <header class="detail-header"><div><p class="eyebrow">Detail</p><h2 id="detailName">-</h2></div><button class="panel-toggle" id="closeDetail" type="button">X</button></header>
          <div class="detail-body">
            <div class="detail-photo-grid" id="detailPhotos"></div>
            <dl class="detail-list">
              <dt>ประเภท</dt><dd id="detailType">-</dd>
              <dt>GPS</dt><dd id="detailGps">-</dd>
              <dt>ขอบเขต</dt><dd id="detailBoundary">-</dd>
              <dt>Timestamp</dt><dd id="detailTimestamp">-</dd>
              <dt>เริ่ม</dt><dd id="detailStart">-</dd>
              <dt>สิ้นสุด</dt><dd id="detailEnd">-</dd>
              <dt>สถานะ</dt><dd id="detailStatus">-</dd>
              <dt>อัปเดต</dt><dd id="detailStatusNote">-</dd>
            </dl>
          </div>
        </div>
      </section>
    </div>

    <nav class="mobile-bottom-nav glass-panel" style="border-top-left-radius: 24px; border-top-right-radius: 24px; overflow: hidden; padding-bottom: calc(env(safe-area-inset-bottom) + 8px);">
      <a href="/" class="hover-scale"><i class="fa-solid fa-arrow-left"></i><span>เลือก role</span></a>
      <button class="active hover-scale" data-section="sec-form" type="button"><i class="fa-solid fa-plus"></i><span>เพิ่มงาน</span></button>
      <button class="hover-scale" data-section="sec-projects" type="button"><i class="fa-solid fa-list"></i><span>โครงการ</span></button>
    </nav>
  </div>

  <script is:inline>
    // Section switcher for contractor bottom nav
    document.querySelectorAll('.mobile-bottom-nav [data-section]').forEach((btn) => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.mobile-bottom-nav [data-section]').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        document.querySelectorAll('#sec-form, #sec-projects').forEach((s) => s.classList.add('section-hidden'));
        document.getElementById(btn.dataset.section).classList.remove('section-hidden');
      });
    });
    if (new URLSearchParams(window.location.search).get('section') === 'projects') {
      document.querySelector('.mobile-bottom-nav [data-section="sec-projects"]')?.click();
    }

    // Keep the polished level cards synchronized with the original select value.
    const constructionLevelSelect = document.getElementById('constructionWorkLevel');
    const constructionLevelOptions = Array.from(document.querySelectorAll('[data-construction-level]'));
    function selectConstructionLevel(level, focus = false) {
      if (!constructionLevelSelect || !constructionLevelOptions.some((option) => option.dataset.constructionLevel === level)) return;
      constructionLevelSelect.value = level;
      constructionLevelOptions.forEach((option) => {
        const selected = option.dataset.constructionLevel === level;
        option.classList.toggle('is-selected', selected);
        option.setAttribute('aria-checked', String(selected));
        option.tabIndex = selected ? 0 : -1;
        if (selected && focus) option.focus();
      });
    }
    constructionLevelOptions.forEach((option, index) => {
      option.addEventListener('click', () => selectConstructionLevel(option.dataset.constructionLevel));
      option.addEventListener('keydown', (event) => {
        const direction = event.key === 'ArrowRight' || event.key === 'ArrowDown' ? 1 : event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 0;
        if (!direction && event.key !== 'Home' && event.key !== 'End') return;
        event.preventDefault();
        const nextIndex = event.key === 'Home' ? 0 : event.key === 'End' ? constructionLevelOptions.length - 1 : (index + direction + constructionLevelOptions.length) % constructionLevelOptions.length;
        selectConstructionLevel(constructionLevelOptions[nextIndex].dataset.constructionLevel, true);
      });
    });
    constructionLevelSelect?.addEventListener('change', () => selectConstructionLevel(constructionLevelSelect.value));
    selectConstructionLevel(constructionLevelSelect?.value || 'medium');

    function readAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(reader.error);
        reader.readAsDataURL(file);
      });
    }

    // ─── Original site-overview photo (multi-photo, removable — same pattern as checkpoints) ───
    window.sitePhotos = window.sitePhotos || [];

    function renderSitePhotoThumbs() {
      const wrap = document.getElementById('contractorPhotoThumbs');
      if (!wrap) return;
      wrap.innerHTML = window.sitePhotos.map((src, i) => `
        <div class="checkpoint-thumb">
          <img src="${src}" alt="">
          <button type="button" class="checkpoint-thumb-remove" data-site-index="${i}" aria-label="ลบรูป">×</button>
        </div>
      `).join('');
    }

    function bindSinglePhotoInput(id) {
      const input = document.getElementById(id);
      if (!input) return;
      input.addEventListener('change', async (e) => {
        const files = Array.from(e.target.files || []);
        if (!files.length) return;
        const dataUrls = await Promise.all(files.map(readAsDataUrl));
        window.sitePhotos = window.sitePhotos.concat(dataUrls);
        renderSitePhotoThumbs();
        e.target.value = '';
      });
    }
    bindSinglePhotoInput('contractorPhotoCamera');
    bindSinglePhotoInput('contractorPhotoGallery');

    document.getElementById('contractorPhotoThumbs')?.addEventListener('click', (e) => {
      const btn = e.target.closest('.checkpoint-thumb-remove');
      if (!btn) return;
      const index = Number(btn.dataset.siteIndex);
      window.sitePhotos.splice(index, 1);
      renderSitePhotoThumbs();
    });

    // ─── 8-checkpoint photo capture (separate camera + gallery inputs per point,
    // since Android/iOS hide the camera option once `multiple` is set) ───
    // window.checkpointPhotos: { cone: [dataUrl, ...], warning_sign: [...], ... }
    window.checkpointPhotos = window.checkpointPhotos || {};
    const CHECKPOINT_TOTAL = 8;

    function renderCheckpointThumbs(key) {
      const wrap = document.querySelector(`.checkpoint-thumbs[data-thumbs="${key}"]`);
      if (!wrap) return;
      const photos = window.checkpointPhotos[key] || [];
      wrap.innerHTML = photos.map((src, i) => `
        <div class="checkpoint-thumb">
          <img src="${src}" alt="">
          <button type="button" class="checkpoint-thumb-remove" data-checkpoint="${key}" data-index="${i}" aria-label="ลบรูป">×</button>
        </div>
      `).join('');
    }

    function updateCheckpointProgress() {
      const filled = Object.values(window.checkpointPhotos).filter((arr) => arr && arr.length > 0).length;
      const el = document.getElementById('checkpointProgress');
      if (el) el.textContent = `แนบรูปแล้ว ${filled}/${CHECKPOINT_TOTAL} จุด`;
    }

    document.querySelectorAll('.checkpoint-input').forEach((input) => {
      input.addEventListener('change', async (e) => {
        const key = e.target.dataset.checkpoint;
        const files = Array.from(e.target.files || []);
        if (!files.length) return;
        const dataUrls = await Promise.all(files.map(readAsDataUrl));
        window.checkpointPhotos[key] = (window.checkpointPhotos[key] || []).concat(dataUrls);
        renderCheckpointThumbs(key);
        updateCheckpointProgress();
        e.target.value = ''; // allow re-selecting the same file again later
      });
    });

    document.getElementById('checkpointGrid')?.addEventListener('click', (e) => {
      const btn = e.target.closest('.checkpoint-thumb-remove');
      if (!btn) return;
      const key = btn.dataset.checkpoint;
      const index = Number(btn.dataset.index);
      if (window.checkpointPhotos[key]) {
        window.checkpointPhotos[key].splice(index, 1);
      }
      renderCheckpointThumbs(key);
      updateCheckpointProgress();
    });
  </script>
</BaseLayout>
